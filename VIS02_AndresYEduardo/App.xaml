<Application x:Class="VIS02_AndresYEduardo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="NAVEWIN.xaml">
    <!--
        App.xaml es el punto de entrada visual de la aplicacion WPF.
        x:Class           : clase C# asociada a este XAML (App.xaml.cs).
        StartupUri        : ventana que WPF abre automaticamente al iniciar la aplicacion.
        Application.Resources : recursos GLOBALES (colores, estilos) que pueden usar
                            todas las ventanas y controles de la aplicacion.
    -->
    <Application.Resources>
        <!--
            =====================================================================
            PALETA MODO NORMAL Y NOCHE
            =====================================================================
            Cada color se guarda como un recurso con una clave (x:Key) para poder
            recuperarlo por su nombre desde el XAML o desde el codigo C#.
            =====================================================================
        -->
        <!-- Colores del MODO NORMAL (claro) -->
        <SolidColorBrush x:Key="NormalBackgroundBrush" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="NormalForegroundBrush" Color="#FF111111" />
        <SolidColorBrush x:Key="NormalControlBgBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="NormalBorderBrush" Color="#FFCCCCCC" />
        <SolidColorBrush x:Key="NormalTextBrush" Color="#FF111111" />
        <SolidColorBrush x:Key="NormalControlBackgroundBrush" Color="#FFFFFFFF" />

        <!-- Colores del MODO NOCHE (oscuro) -->
        <SolidColorBrush x:Key="NocheBackgroundBrush" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="NocheForegroundBrush" Color="#FFF0F0F0" />
        <SolidColorBrush x:Key="NocheControlBgBrush" Color="#FF2D2D30" />
        <SolidColorBrush x:Key="NocheBorderBrush" Color="#FF3F3F46" />
        <SolidColorBrush x:Key="NocheTextBrush" Color="#FFF0F0F0" />
        <SolidColorBrush x:Key="NocheControlBackgroundBrush" Color="#FF2D2D30" />

        <!-- PINCELES ACTIVOS DEL TEMA ACTUAL (arrancan en modo normal) -->
        <SolidColorBrush x:Key="CurrentBackgroundBrush" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="CurrentForegroundBrush" Color="#FF111111" />
        <SolidColorBrush x:Key="CurrentControlBgBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="CurrentBorderBrush" Color="#FFCCCCCC" />

        <!--
            ESTILOS IMPLICITOS GLOBALES
            Se aplican automaticamente a los controles de toda la aplicacion.
            Al usar DynamicResource, cualquier cambio en Current... actualiza
            los controles en tiempo real.
        -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource CurrentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CurrentForegroundBrush}" />
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource CurrentBackgroundBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CurrentForegroundBrush}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource CurrentForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource CurrentForegroundBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CurrentControlBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CurrentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderBrush}" />
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource CurrentControlBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CurrentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CurrentBorderBrush}" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource CurrentForegroundBrush}" />
        </Style>
    </Application.Resources>
</Application>
