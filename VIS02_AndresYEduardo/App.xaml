<Application x:Class="VIS02_AndresYEduardo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="NAVEWIN.xaml">
    <Application.Resources>
        <!-- PALETA MODO NORMAL Y NOCHE -->
        <SolidColorBrush x:Key="NormalBackgroundBrush" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="NormalForegroundBrush" Color="#FF111111" />
        <SolidColorBrush x:Key="NormalControlBgBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="NormalTextBrush" Color="#FF111111" />
        <SolidColorBrush x:Key="NormalControlBackgroundBrush" Color="#FFFFFFFF" />

        <SolidColorBrush x:Key="NocheBackgroundBrush" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="NocheForegroundBrush" Color="#FFF0F0F0" />
        <SolidColorBrush x:Key="NocheControlBgBrush" Color="#FF2D2D30" />
        <SolidColorBrush x:Key="NocheTextBrush" Color="#FFF0F0F0" />
        <SolidColorBrush x:Key="NocheControlBackgroundBrush" Color="#FF2D2D30" />

        <Style TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource NormalBackgroundBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NormalForegroundBrush}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource NormalForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource NormalBackgroundBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource NormalForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource NormalControlBgBrush}" />
        </Style>
    </Application.Resources>
</Application>
