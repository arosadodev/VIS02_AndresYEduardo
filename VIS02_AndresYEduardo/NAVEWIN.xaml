<Window x:Class="VIS02_AndresYEduardo.NAVEWIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NAVEWIN HiperGaler&#237;a"
        Height="550"
        Width="800">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="8,4,12,4" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Background="{DynamicResource NormalBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8">
            <Button Content="Seleccionar Carpeta"
                    Style="{StaticResource NavButtonStyle}"
                    Click="SeleccionarCarpeta_Click" />
            <CheckBox x:Name="ChkModoNoche"
                      Content="Modo Noche"
                      VerticalAlignment="Center"
                      Margin="8,0,16,0"
                      Checked="ModoNoche_Cambio"
                      Unchecked="ModoNoche_Cambio" />
            <Label x:Name="LblRutaActual"
                   VerticalAlignment="Center"
                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
        </StackPanel>

        <TreeView x:Name="TvDirectorio"
                  Grid.Row="1"
                  Margin="8"
                  SelectedItemChanged="Directorio_ElementoSeleccionado" />
    </Grid>
</Window>
