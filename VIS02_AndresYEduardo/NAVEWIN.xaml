<Window x:Class="VIS02_AndresYEduardo.NAVEWIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visor Multimedia"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CurrentBackgroundBrush}">
    <!--
        VENTANA PRINCIPAL (navegador)
        =====================================================================
        Estructura visual con tres filas:
          Fila 0 : Cabecera con el titulo de la aplicacion.
          Fila 1 : Barra de herramientas (boton, checkbox, ruta).
          Fila 2 : Arbol de carpetas y archivos.
        =====================================================================
    -->
    <Window.Resources>
        <!-- Estilo de los botones de la barra de herramientas. -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Background="{DynamicResource CurrentBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Fila 0: cabecera con titulo -->
            <RowDefinition Height="Auto" />
            <!-- Fila 1: barra de herramientas -->
            <RowDefinition Height="Auto" />
            <!-- Fila 2: arbol de directorios -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ================================================================
            FILA 0 — CABECERA
            ================================================================
            Un Border con fondo azul (#007ACC) que contiene el titulo
            de la aplicacion. Ocupa todo el ancho de la ventana y da
            identidad visual al proyecto.
        -->
        <Border Grid.Row="0"
                Background="#FF007ACC"
                Padding="16,10">
            <TextBlock Text="📁  Visor Multimedia"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White" />
        </Border>

        <!--
            ================================================================
            FILA 1 — BARRA DE HERRAMIENTAS
            ================================================================
            Contiene el boton de seleccionar carpeta, el modo noche
            y la ruta actual. Se separa de la cabecera con un borde inferior
            fino para dar un aspecto limpio.
        -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource CurrentBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <!-- Boton y checkbox a la izquierda -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="📂 Seleccionar Carpeta"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SeleccionarCarpeta_Click" />
                    <CheckBox x:Name="ChkModoNoche"
                              Content="🌙 Modo Noche"
                              Foreground="{DynamicResource CurrentForegroundBrush}"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0"
                              Checked="ModoNoche_Cambio"
                              Unchecked="ModoNoche_Cambio" />
                </StackPanel>

                <!-- Ruta actual a la derecha, ocupando el espacio restante -->
                <Label x:Name="LblRutaActual"
                       DockPanel.Dock="Right"
                       Foreground="{DynamicResource CurrentForegroundBrush}"
                       Opacity="0.7"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
            </DockPanel>
        </Border>

        <!--
            ================================================================
            FILA 2 — ARBOL DE DIRECTORIOS
            ================================================================
            El TreeView ocupa todo el espacio restante.
            Se envuelve en un Border con esquinas redondeadas y margen
            para separarlo visualmente de los bordes de la ventana.
        -->
        <Border Grid.Row="2"
                Margin="12"
                CornerRadius="4"
                BorderBrush="{DynamicResource CurrentBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource CurrentControlBgBrush}">
            <TreeView x:Name="TvDirectorio"
                      Background="Transparent"
                      Foreground="{DynamicResource CurrentForegroundBrush}"
                      BorderThickness="0"
                      Padding="4"
                      SelectedItemChanged="Directorio_ElementoSeleccionado" />
        </Border>
    </Grid>
</Window>
