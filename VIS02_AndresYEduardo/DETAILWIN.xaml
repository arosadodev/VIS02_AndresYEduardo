<Window x:Class="VIS02_AndresYEduardo.DETAILWIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="Visor de Detalle" Height="600" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MediaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DetailButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF28A745"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="DetailGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" x:Name="PanelControles" Orientation="Horizontal" Margin="0,0,0,10"/>
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
            <Grid x:Name="ContentHostGrid">
                <Image x:Name="ImgViewer" Style="{StaticResource ImageDetailStyle}" Visibility="Collapsed"/>
                <MediaElement x:Name="MediaViewer" Style="{StaticResource MediaDetailStyle}" Visibility="Collapsed"/>
                <TextBox x:Name="TxtViewer" Style="{StaticResource TextDetailStyle}" Visibility="Collapsed"/>
                <md:MarkdownScrollViewer x:Name="MdViewer" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource DetailButtonStyle}" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
