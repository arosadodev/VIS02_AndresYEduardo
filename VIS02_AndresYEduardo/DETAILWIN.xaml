<Window x:Class="VIS02_AndresYEduardo.DETAILWIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Height="600" Width="800"
        MinHeight="350"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CurrentBackgroundBrush}">
    <!--
        VENTANA DE DETALLE (visor)
        =====================================================================
        Estructura visual con cuatro filas:
          Fila 0 : Cabecera azul con el nombre del archivo.
          Fila 1 : Barra de botones de control (Zoom, Play, Texto +/-).
          Fila 2 : Contenido del archivo (imagen, video, texto o markdown).
          Fila 3 : Boton Cancelar.
        =====================================================================
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MediaStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Estilo de los botones de control de esta ventana. -->
            <Style x:Key="DetailButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF28A745"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="DetailGrid" Background="{DynamicResource CurrentBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Fila 0: cabecera con nombre del archivo -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: botones de control -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2: contenido -->
            <RowDefinition Height="*"/>
            <!-- Fila 3: boton cancelar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            ================================================================
            FILA 0 — CABECERA
            ================================================================
            Muestra el nombre del archivo que se esta visualizando.
            El TextBlock x:Name="TxtNombreArchivo" se rellena desde C#.
        -->
        <Border Grid.Row="0"
                Background="#FF007ACC"
                Padding="14,8">
            <TextBlock x:Name="TxtNombreArchivo"
                       Text="Archivo"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White" />
        </Border>

        <!--
            ================================================================
            FILA 1 — BARRA DE BOTONES
            ================================================================
            Empieza vacia; el code-behind agrega botones segun el tipo
            de archivo (Zoom +/-, Play/Pausa/Stop, Texto +/-).
        -->
        <StackPanel Grid.Row="1"
                    x:Name="PanelControles"
                    Orientation="Horizontal"
                    Margin="12,8,12,4"/>

        <!--
            ================================================================
            FILA 2 — CONTENIDO
            ================================================================
            Los cuatro visores estan superpuestos en la misma celda,
            todos ocultos. El code-behind muestra solo el que corresponda.
        -->
        <Border x:Name="MarcoContenido" Grid.Row="2"
                Margin="12,4,12,8"
                CornerRadius="4"
                BorderBrush="{DynamicResource CurrentBorderBrush}"
                Background="{DynamicResource CurrentControlBgBrush}"
                BorderThickness="1">
            <Grid x:Name="ContentHostGrid">
                <Image x:Name="ImgViewer" Style="{StaticResource ImageDetailStyle}" Visibility="Collapsed"/>
                <MediaElement x:Name="MediaViewer" Style="{StaticResource MediaDetailStyle}" Visibility="Collapsed"/>
                <TextBox x:Name="TxtViewer" Style="{StaticResource TextDetailStyle}" Visibility="Collapsed"/>
                <md:MarkdownScrollViewer x:Name="MdViewer"
                                         Background="{DynamicResource CurrentControlBgBrush}"
                                         Foreground="{DynamicResource CurrentForegroundBrush}"
                                         Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!--
            ================================================================
            FILA 3 — BOTON CANCELAR
            ================================================================
        -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="12,0,12,10">
            <Button Content="✕ Cerrar" IsCancel="True"
                    Style="{StaticResource DetailButtonStyle}"
                    Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
