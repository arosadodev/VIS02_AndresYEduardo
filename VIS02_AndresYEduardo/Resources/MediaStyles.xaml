<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ImageDetailStyle" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    <Style x:Key="MediaDetailStyle" TargetType="MediaElement">
        <Setter Property="LoadedBehavior" Value="Manual"/>
        <Setter Property="UnloadedBehavior" Value="Stop"/>
    </Style>
    <Style x:Key="TextDetailStyle" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
</ResourceDictionary>
